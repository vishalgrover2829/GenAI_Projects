# Ollama must be running locally: ollama serve
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llava:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Qdrant Cloud configuration. Keep QDRANT_PATH empty for remote Qdrant.
QDRANT_PATH=
QDRANT_URL=https://your-cluster-endpoint
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=mm-rag-ollama

# Optional. If blank, the dimension is detected from Ollama.
OLLAMA_EMBEDDING_DIMENSION=
TESSERACT_PATH=
